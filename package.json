{
  "name": "dsh-unified-quota",
  "description": "DSH 额度中心：官方余额 + 渠道积分 + 自有账本 + 多平台明细（筛选/口径/趋势/构成/排行/逐次调用/CSV/渠道展开）+ 积分倍率与等效量 + 设置页 + 每日实时汇率。",
  "version": "7.26.1",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets",
    "test",
    "scripts"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "balance",
    "quota",
    "usage",
    "cost",
    "credits"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/all.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:all": "node scripts/check-hooks.mjs && node test/all.mjs"
  }
}
